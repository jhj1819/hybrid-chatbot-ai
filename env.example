# OpenAI API 키 (App Runner 환경 변수에서 설정)
OPENAI_API_KEY=your_openai_api_key_here

# 서버 설정 (App Runner에서 자동 설정됨)
PORT=8000
WORKERS=1

# Python 경로 설정
PYTHONPATH=/app

# 로그 설정
LOG_LEVEL=info

# App Runner 환경 설정
ENVIRONMENT=production

# 보안 설정 (선택사항)
# ALLOWED_ORIGINS=https://your-app-runner-url.region.awsapprunner.com
# API_KEY=your_api_key_for_authentication

# FAISS 인덱스 설정
FAISS_INDEX_PATH=faiss_index
